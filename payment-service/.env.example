# ==============================================================================
# CONFIGURATION SERVEUR RENDER & BASE
# ==============================================================================
PORT=10000
NODE_ENV=production
FIREBASE_PROJECT_ID=pos-app-1759a

# Clé de compte de service Firebase Admin (JSON sous forme de chaîne sans retours à la ligne)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"pos-app-1759a",...}

# URL du Proxy Statique Fixie (IP Whitelisting Bancaire - Sortie garantie)
# Exemple : http://fixie:cle_secrete_fixie@velvet.usefixie.com:80
FIXIE_URL=

# ==============================================================================
# MISSION 0 : YOUTUBE DATA API V3 & GOOGLE OAUTH 2.0 (WAMEET LIVE)
# ==============================================================================
# Identifiants OAuth 2.0 générés sur Google Cloud Console (Client Web)
# Compte : pousbila04@gmail.com
# URIs de redirection autorisés dans Google Cloud Console :
#   - https://nana-payment-api.onrender.com/api/youtube/callback
#   - http://localhost:10000/api/youtube/callback
YOUTUBE_CLIENT_ID=votre_client_id_google.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-votre_client_secret_google
YOUTUBE_REDIRECT_URI=https://nana-payment-api.onrender.com/api/youtube/callback

# Stream Router & Failover Jitsi Meet (Résilience Quota YouTube : ~30 Lives/jour)
MAX_YOUTUBE_DAILY_LIVES=30
YOUTUBE_API_TIMEOUT_MS=4000
JITSI_DOMAIN=meet.jit.si

# ==============================================================================
# MISSION 1 : PASSERELLE SEBPAY (MOBILE MONEY UEMOA & CARTES)
# ==============================================================================
# Clés API fournies par le dashboard marchand Sebpay (Bénin, Togo, CI, UEMOA)
SEBPAY_PUBLIC_KEY=pk_live_votre_cle_publique_sebpay
SEBPAY_SECRET_KEY=sk_live_votre_cle_secrete_sebpay
SEBPAY_BASE_URL=https://newapi.sebpay.bj/api/v1/

# Clé secrète de secours pour validation cryptographique HMAC-SHA256
PAYMENT_WEBHOOK_SECRET=konkobo_telecom_webhook_secret_key_2026

# ==============================================================================
# MISSION 2 : MOTEUR DE SPLIT FINANCIER AUTOMATISÉ (NANASORE CENTRAL)
# ==============================================================================
# Pourcentage de commission prélevé automatiquement par la plateforme (5% par défaut)
PLATFORM_COMMISSION_PERCENT=5

# ==============================================================================
# MISSION 3 : SERVICES DE COMMUNICATION (REÇUS SMS & EMAIL POST-PAIEMENT)
# ==============================================================================
# 1. Envoi SMS & WhatsApp via Twilio (Coût : 25 FCFA par SMS)
TWILIO_ACCOUNT_SID=AC_votre_twilio_account_sid
TWILIO_AUTH_TOKEN=votre_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
COMMUNICATION_SMS_COST_FCFA=25

# 2. Envoi Email transactionnel via Brevo / ex-Sendinblue (Coût : 5 FCFA par Email)
BREVO_API_KEY=xkeysib-votre_cle_api_brevo
BREVO_SENDER_NAME=Wameet / Nanasore Live
BREVO_SENDER_EMAIL=notifications@wameet.africa
COMMUNICATION_EMAIL_COST_FCFA=5

# ==============================================================================
# COFFRE-FORT NANASWITCH (CHIFFREMENT AES-256-GCM)
# ==============================================================================
NANASWITCH_MASTER_KEY=nanaswitch_node_master_aes256_gcm_vault_key_prod_v2
