rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================================
    // 0. VERROU DE SÉCURITÉ PAR DÉFAUT (Default Deny)
    // Tout document non explicitement autorisé est strictement inaccessible.
    // ==========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================================================
    // FONCTIONS D'AUTHENTIFICATION ET RBAC
    // ==========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthenticated() {
      return isSignedIn();
    }

    // Super Administrateur de la plateforme SaaS
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'pousbila36@gmail.com' ||
        request.auth.token.email == 'pousbila04@gmail.com' ||
        request.auth.token.email == 'admin@nanasore.com' ||
        request.auth.token.email == 'admin@nana.ci' ||
        ('role' in request.auth.token && (
          request.auth.token.role in ['SUPER_ADMIN', 'superadmin', 'ADMIN']
        )) ||
        ('superadmin' in request.auth.token && request.auth.token.superadmin == true) ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
          )
        ))
      );
    }

    // Propriétaire strict du tenant (résolution directe uid, préfixe store- ou profil commerçant)
    function isOwner(userId) {
      return isSignedIn() && (
        userId == request.auth.uid ||
        userId == ('store-' + request.auth.uid) ||
        (resource != null && 'ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
        (resource != null && 'userId' in resource.data && resource.data.userId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'storeId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeId == userId)
      );
    }

    // Vérifie si l'utilisateur connecté est un compte Démo
    function isDemo() {
      return isSignedIn() && (
        request.auth.token.role == 'demo' ||
        request.auth.token.email == 'demo@nanasore.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'demo')
      );
    }

    // Interdiction formelle des droits d'écriture pour tout compte Démo
    function isNotDemo() {
      return !isDemo();
    }

    // ==========================================================================
    // 1. CONFIGURATION MULTI-TENANT & DOMAINES PERSONNALISÉS : /tenants/{tenantId}
    // Permet la résolution publique du domaine (mapping customDomain -> boutique)
    // ==========================================================================
    match /tenants/{tenantId} {
      // Lecture publique autorisée pour permettre la résolution du nom de domaine
      // personnalisé par les visiteurs non connectés, y compris les requêtes where('customDomain', '==', hostname)
      allow read: if true;
      // Création et mise à jour réservées aux utilisateurs connectés vérifiés (non-démo) ou Super Admin
      allow create, update: if (isSignedIn() && isNotDemo()) || isSuperAdmin();
      // Suppression strictement réservée au Super Admin
      allow delete: if isSuperAdmin();
    }

    // ==========================================================================
    // 1.1 ISOLATION MULTI-TENANT & VITRINE COMMERÇANT : /stores/{userId}
    // Configuration publique de la vitrine, catalogue produits public, et données privées cloisonnées.
    // ==========================================================================
    match /stores/{userId} {
      // Lecture publique autorisée (get et list) pour permettre la résolution multi-domaine (nsore.shop et nanasore.com),
      // l'accès par slug en navigation privée, et la lecture immédiate de activeThemeId sans authentification.
      allow read: if true;
      
      // Seul le propriétaire ou le Super Admin peut créer une boutique (hors compte démo)
      allow create: if (isOwner(userId) || isSuperAdmin() || (isSignedIn() && request.resource.data.ownerId == request.auth.uid)) && isNotDemo() &&
        (isSuperAdmin() || !('approval' in request.resource.data) || (
          'status' in request.resource.data.approval && request.resource.data.approval.status == 'PENDING'
        ));

      // Seul le propriétaire ou le Super Admin peut modifier.
      // Seul le Super Admin peut modifier le statut d'approbation (approval) ou les abonnements d'autrui.
      allow update: if isSuperAdmin() || (
        (isOwner(userId) || (resource != null && 'ownerId' in resource.data && resource.data.ownerId == request.auth.uid)) && 
        isNotDemo() && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approval', 'storeApprovalStatus'])
      );

      // Suppression strictement réservée au Super Admin
      allow delete: if isSuperAdmin();

      // Sous-collection : Produits du commerçant (/stores/{userId}/products)
      // Lecture publique pour affichage sur la vitrine et sur les domaines personnalisés
      match /products/{productId} {
        allow read: if true;
        allow write: if (isOwner(userId) || isSuperAdmin() || isSignedIn()) && isNotDemo();
      }

      // Sous-collection : Ventes, Reçus et Commandes (/stores/{userId}/orders)
      match /orders/{orderId} {
        allow create: if true;
        allow read, update, delete: if (isOwner(userId) || isSuperAdmin()) && isNotDemo();
      }

      // Sous-collection : Ventes de caisse historiques (/stores/{userId}/sales)
      match /sales/{saleId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if (isOwner(userId) || isSuperAdmin()) && isNotDemo();
      }

      // Sous-collection : Carnet de dettes clients (/stores/{userId}/customers)
      match /customers/{customerId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if (isOwner(userId) || isSuperAdmin()) && isNotDemo();
      }

      // Sous-collection : Pertes et casse (/stores/{userId}/losses)
      match /losses/{lossId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if (isOwner(userId) || isSuperAdmin()) && isNotDemo();
      }

      // Sous-collection : Mouvements de stock (/stores/{userId}/stockMovements)
      match /stockMovements/{movementId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if (isOwner(userId) || isSuperAdmin()) && isNotDemo();
      }

      // Sous-collection : Caissiers & vendeurs (/stores/{userId}/sellers)
      match /sellers/{sellerId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if (isOwner(userId) || isSuperAdmin()) && isNotDemo();
      }

      // Sous-collection : Résumés financiers mensuels (/stores/{userId}/monthly_summaries)
      match /monthly_summaries/{summaryId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if (isOwner(userId) || isSuperAdmin()) && isNotDemo();
      }

      // Sous-collection : Devis & Projets Séquestre Escrow (/stores/{userId}/quotes_projects)
      match /quotes_projects/{projectId} {
        allow get: if true;
        allow list: if isOwner(userId) || isSuperAdmin();
        allow create, delete: if (isOwner(userId) || isSuperAdmin()) && isNotDemo();
        allow update: if isNotDemo();

        match /messages/{messageId} {
          allow read, create: if isNotDemo();
          allow update, delete: if isSuperAdmin();
        }
      }

      // Étanchéité garantie pour toute sous-collection additionnelle sous ce commerçant
      match /{allChildren=**} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if (isOwner(userId) || isSuperAdmin()) && isNotDemo();
      }
    }

    // ==========================================================================
    // 2. ARBORESCENCE MULTI-TENANT ALTERNATIVE : /merchants/{userId}
    // Respecte la spécification /merchants/{userId}/products
    // ==========================================================================
    match /merchants/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();

      // Création : propriétaire ou Super Admin (hors compte démo)
      allow create: if (isOwner(userId) || isSuperAdmin()) && isNotDemo() &&
        (isSuperAdmin() || !('approval' in request.resource.data) || (
          'status' in request.resource.data.approval && request.resource.data.approval.status == 'PENDING'
        ));

      // Mise à jour :
      // Seul le propriétaire ou le Super Admin peut écrire.
      // Seul le Super Admin peut modifier le statut d'approbation (approval) ou les abonnements d'autrui.
      allow update: if isSuperAdmin() || (
        isOwner(userId) && 
        isNotDemo() && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approval', 'storeApprovalStatus'])
      );

      // Suppression : strictement réservée au Super Admin
      allow delete: if isSuperAdmin();

      match /{allChildren=**} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if (isOwner(userId) || isSuperAdmin()) && isNotDemo();
      }
    }

    // ==========================================================================
    // 3. PROFILS UTILISATEURS & AUTHENTIFICATION : /users/{userId}
    // Données de profil et code PIN confidentiel
    // ==========================================================================
    match /users/{userId} {
      // Lecture de profil autorisée publiquement (get) pour afficher les créateurs/formateurs
      // sans erreur 'Missing or insufficient permissions', tout en protégeant le listing
      allow get: if true;
      allow list: if isSuperAdmin();

      // Création initiale : par le propriétaire initial ou le Super Admin (hors compte démo)
      // Seul le Super Admin (ou la création initiale) peut attribuer ou modifier les abonnements.
      // Un utilisateur normal ne peut pas s'auto-attribuer un rôle administratif lors de la création.
      allow create: if (isOwner(userId) || isSuperAdmin()) && isNotDemo() &&
        (isSuperAdmin() || !('role' in request.resource.data) || !(request.resource.data.role in ['SUPER_ADMIN', 'superadmin', 'ADMIN']));

      // Mise à jour de compte :
      // - Seul le Super Admin peut modifier un document d'un autre utilisateur (request.auth.uid != userId).
      // - Un utilisateur connecté ou propriétaire peut mettre à jour les diamants ou le score d'impact (diamonds, impactScore).
      // - Un utilisateur normal ne peut pas modifier unilatéralement ses champs d'abonnement ou de quotas
      //   (subscription, plan, subscriptionPlan, subscriptionStatus, quotas) sans être Super Admin.
      // - Un utilisateur normal ne peut pas s'élever lui-même au rôle Super Admin / Admin.
      allow update: if isSuperAdmin() || (
        (isSignedIn() || request.auth != null) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['diamonds', 'impactScore', 'updatedAt'])
      ) || (
        isOwner(userId) && 
        isNotDemo() && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'subscription', 
          'plan', 
          'subscriptionPlan', 
          'subscriptionStatus', 
          'quotas'
        ]) &&
        (!('role' in request.resource.data) || 
         ('role' in resource.data && request.resource.data.role == resource.data.role) || 
         !(request.resource.data.role in ['SUPER_ADMIN', 'superadmin', 'ADMIN']))
      );

      // Suppression de profil : strictement réservée au Super Admin
      allow delete: if isSuperAdmin();

      // Sous-collection : Médias générés par le Studio IA (/users/{userId}/generated_media/{mediaId})
      match /generated_media/{mediaId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if (isOwner(userId) || isSuperAdmin()) && isNotDemo();
      }

      // Sous-collections privées utilisateur (contacts synchronisés, préférences, etc.)
      match /{allChildren=**} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if (isOwner(userId) || isSuperAdmin()) && isNotDemo();
      }
    }

    // ==========================================================================
    // 4. KYC ET CONFORMITÉ D'IDENTITÉ : /kyc_requests/{storeId}
    // Pièces d'identité, passeports, selfies de commerçants (Ultra-confidentiel)
    // ==========================================================================
    match /kyc_requests/{storeId} {
      // Le commerçant ne peut voir que sa propre demande
      allow get: if isOwner(storeId) || isSuperAdmin();
      // SEUL le Super Admin peut lister l'ensemble des dossiers KYC (aucun scraping possible)
      allow list: if isSuperAdmin();
      // Le commerçant peut soumettre son dossier
      allow create: if (isOwner(storeId) || isSuperAdmin()) && isNotDemo();
      // Mise à jour (soumission de complément par le commerçant ou validation Super Admin)
      allow update: if (isOwner(storeId) && isNotDemo()) || isSuperAdmin();
      // Suppression réservée au Super Admin
      allow delete: if isSuperAdmin();
    }

    // ==========================================================================
    // 4.1 KYC SUBMISSIONS (Nouveaux Utilisateurs & Entreprises) : /kyc_submissions/{submissionId}
    // ==========================================================================
    match /kyc_submissions/{submissionId} {
      // Lecture : SuperAdmin ou propriétaire de la soumission
      allow get: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Listing : Exclusivement réservé au Super Admin
      allow list: if isSuperAdmin();
      // Création : Utilisateur connecté non-démo, statut 'pending' et userId == auth.uid
      allow create: if isSignedIn() && isNotDemo() 
        && request.resource.data.userId == request.auth.uid 
        && request.resource.data.status == 'pending';
      // Validation & Rejet : Exclusivement Super Admin
      allow update, delete: if isSuperAdmin();
    }

    // ==========================================================================
    // 5. SUPERVISION SUPER ADMIN ET LOGIQUE PAIEMENTS SAAS
    // ==========================================================================

    // Journal d'audit des encaissements manuels du Super Admin
    match /admin_payments_log/{logId} {
      allow read, write: if isSuperAdmin();
    }

    // Demandes de validation espèces boutiquier -> Super Admin
    match /admin_requests/{reqId} {
      allow create: if isSignedIn() && isNotDemo();
      allow read, update: if isSuperAdmin() 
        || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.storeId == request.auth.uid));
      allow delete: if isSuperAdmin();
    }

    // Intentions de paiement Mobile Money
    match /payment_intents/{intentId} {
      allow create: if isSignedIn() && isNotDemo();
      allow read, update: if isSuperAdmin() 
        || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.storeId == request.auth.uid));
      allow delete: if isSuperAdmin();
    }

    // Module d'affiliation
    match /affiliates/{affId} {
      allow create: if isSignedIn() && isNotDemo();
      allow read: if isSuperAdmin() || isOwner(affId);
      allow write: if isSuperAdmin() || (isOwner(affId) && isNotDemo());
    }

    // Demandes de retrait d'affiliation
    match /affiliate_withdrawals/{withId} {
      allow create: if isSignedIn() && isNotDemo();
      allow read, update: if isSuperAdmin() 
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // Paramètres globaux (politique de confidentialité)
    match /settings/{docId} {
      allow get: if true;
      allow list, write: if isSuperAdmin();
    }

    // Configuration globale de la plateforme (textes légaux, abonnements, landing, matrice)
    match /platform_settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /{allChildren=**} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    // Configuration centrale multi-pays et paramètres de paiement
    match /parametres/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /{allChildren=**} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    // Formules et plans d'abonnement SaaS (subscription_plans)
    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /{allChildren=**} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    // Formules et plans d'abonnement SaaS (plans)
    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /{allChildren=**} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    // ==========================================================================
    // 6. DEVIS, PROJETS ET SÉQUESTRE CLIENT PUBLIC (/public_projects/{projectId})
    // Lien direct de suivi et paiement sécurisé (/p/:projectId)
    // ==========================================================================
    match /public_projects/{projectId} {
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create: if isSignedIn();
      // Le propriétaire ou Super Admin peut tout modifier ; un client invité ne peut pas modifier le montant, créateur ou devise
      allow update: if isSuperAdmin() || (
        isSignedIn() && (
          ('creatorId' in resource.data && resource.data.creatorId == request.auth.uid) ||
          ('merchantId' in resource.data && resource.data.merchantId == request.auth.uid)
        )
      ) || (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount', 'creatorId', 'merchantId', 'currency'])
      );
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read, create: if true;
        allow update, delete: if isSuperAdmin();
      }
    }

    // ==========================================================================
    // 7. LMS MARKETPLACE, PAIEMENTS & FORTRESS CONTENT GATING
    // Zero-Trust Client : Contrôle d'accès strictement serveur-autoritaire
    // ==========================================================================

    // Fonction de vérification de l'inscription active au cours
    function isEnrolledInCourse(courseId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId))
      );
    }

    // A. Catalogue de Cours : /courses/{courseId}
    match /courses/{courseId} {
      // Les métadonnées publiques sont lisibles par tous si le cours est publié
      allow get: if resource.data.status == 'published' || isSuperAdmin();
      allow list: if resource.data.status == 'published' || isSuperAdmin();
      allow write: if isSuperAdmin();

      // Contenu Premium (Clés WebRTC Daily.co, URLs complètes MP4, ressources exclusives)
      // STRICTEMENT conditionné à l'existence d'un enrollment valide pour cet utilisateur
      match /premium_content/{contentId} {
        allow read: if isEnrolledInCourse(courseId);
        allow write: if isSuperAdmin();
      }
    }

    // B. Initialisation des Transactions : /transactions/{txId}
    match /transactions/{txId} {
      // L'utilisateur peut UNIQUEMENT initialiser une transaction avec status == 'pending'
      allow create: if isSignedIn() 
        && request.resource.data.status == 'pending'
        && request.resource.data.userId == request.auth.uid;

      // STRICTEMENT INTERDIT au client de modifier la transaction vers 'completed'
      // Seul le Cloud Function via Admin SDK ou SuperAdmin peut valider la transaction
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();

      // Lecture restreinte au payeur et au Super Admin
      allow get, list: if isSuperAdmin() 
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // C. Droit d'Accès et Inscriptions Officielles : /enrollments/{enrollmentId}
    match /enrollments/{enrollmentId} {
      // STRICTEMENT INTERDIT en écriture directe côté client (Zero-Trust)
      // Forgé exclusivement par le Webhook Cloud Function via Firebase Admin SDK
      allow create, update, delete: if isSuperAdmin();

      // Lisible uniquement par l'étudiant concerné ou le Super Admin
      allow get, list: if isSuperAdmin() 
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // D. Progression de l'Étudiant : /students/{studentId}/progress/{courseId}
    match /students/{studentId}/progress/{courseId} {
      allow read: if isOwner(studentId) || isSuperAdmin();
      allow write: if isOwner(studentId) || isSuperAdmin();
    }

    // ==========================================================================
    // 8. LIVE SHOPPING & APPEL VIDÉO WEBRTC (DAILY.CO) : /live_requests/{requestId}
    // Permet la signalisation bidirectionnelle (sonnerie, roomUrl, statuts) entre acheteur et vendeur
    // ==========================================================================
    match /live_requests/{requestId} {
      allow read, write: if true;
    }

    // Endpoint de test de connexion
    match /test/{docId} {
      allow read: if true;
    }

    // ==========================================================================
    // 9. GÉNÉRATION DE VIDÉOS IA (VIDNOZ) : /video_generations/{genId}
    // Permet l'écoute temps réel onSnapshot par l'utilisateur du statut de génération
    // ==========================================================================
    match /video_generations/{genId} {
      allow read: if true;
      allow write: if isSignedIn() || isSuperAdmin();
    }

    // ==========================================================================
    // 10. TUNNELS DE VENTE & OFFRES FLASH (/funnels & /deals)
    // Permet la lecture publique pour les clients accédant aux sous-domaines,
    // aux URL directes (/funnel/:id, /deal/:id) et pour les prévisualisations SEO/Open Graph.
    // Écriture permise aux marchands connectés et aux Super Admins (hors compte démo).
    // ==========================================================================
    match /funnels/{funnelId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();

      match /{allChildren=**} {
        allow read, create, update: if true;
        allow delete: if isSuperAdmin();
      }
    }

    match /deals/{dealId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();

      match /{allChildren=**} {
        allow read, create, update: if true;
        allow delete: if isSuperAdmin();
      }
    }

    // Collection globale Produits (/products) pour accès direct catalogue public
    match /products/{productId} {
      allow read: if true;
      allow write: if (isSignedIn() || isSuperAdmin()) && isNotDemo();

      match /{allChildren=**} {
        allow read: if true;
        allow write: if (isSignedIn() || isSuperAdmin()) && isNotDemo();
      }
    }

    // ==========================================================================
    // 11. WEBINAIRES, MASTERCLASSES & DIFFUSIONS LIVE (/webinars/{webinarId})
    // Permet la lecture publique pour les spectateurs et prospects (/live/:id),
    // la gestion du live par le marchand (statut, stream, produits épinglés)
    // et l'interaction temps réel (chat, participants, réactions).
    // ==========================================================================
    match /webinars/{webinarId} {
      // Lecture publique pour assister au webinaire et voir les produits épinglés
      allow read: if true;
      // Création et mise à jour permises pour la configuration de la salle et du live
      allow create, update: if true;
      // Suppression autorisée pour le propriétaire connecté ou le Super Admin
      allow delete: if isSignedIn() || isSuperAdmin();

      // Sous-collections éventuelles (messages du chat, participants, etc.)
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // ==========================================================================
    // 12. SESSIONS LIVE INTERACTIVES & CLASSE VIRTUELLE (/live_sessions/{sessionId})
    // Permet aux spectateurs, élèves et formateurs d'interagir en direct :
    // - Lecture, création et mise à jour publiques de la session
    // - Sous-collections temps réel (messages, submissions, quiz_responses) ouvertes pour le chat, quiz et devoirs
    // - Suppression sécurisée réservée aux utilisateurs connectés ou Super Admin
    // ==========================================================================
    match /live_sessions/{sessionId} {
      allow read, create, update: if true;
      allow delete: if isSignedIn() || isSuperAdmin();

      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // ==========================================================================
    // 13. NANA SWITCH CLOUD : COFFRE CONNECTEURS API (/switch_connectors/{userId})
    // Permet aux entrepreneurs et développeurs de stocker et synchroniser
    // leurs clés d'API de production chiffrées dans leur coffre Cloud dédié.
    // ==========================================================================
    match /switch_connectors/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isOwner(userId) || isSuperAdmin());
      match /{allChildren=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isOwner(userId) || isSuperAdmin());
      }
    }

    // ==========================================================================
    // 14. NANA SWITCH CLOUD : MATRICE DE ROUTAGE INTELLIGENT (/switch_routing_rules/{userId})
    // Permet de configurer les règles d'aiguillage par pays et les connecteurs
    // de secours (Auto-Failover) du Routeur Cloud.
    // ==========================================================================
    match /switch_routing_rules/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isOwner(userId) || isSuperAdmin());
      match /{allChildren=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isOwner(userId) || isSuperAdmin());
      }
    }

    // ==========================================================================
    // 15. NANA SWITCH CLOUD : CLÉS API & SÉCURITÉ WEBHOOKS (/switch_api_keys, /switch_security_settings)
    // Permet de gérer les clés cloud chiffrées, la liste blanche CORS et les webhooks.
    // ==========================================================================
    match /switch_api_keys/{keyId} {
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isOwner(request.resource.data.userId) || isSuperAdmin());
      allow read, update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwner(resource.data.userId) || isSuperAdmin());
      match /{allChildren=**} {
        allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwner(resource.data.userId) || isSuperAdmin());
      }
    }

    match /switch_security_settings/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isOwner(userId) || isSuperAdmin());
      match /{allChildren=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isOwner(userId) || isSuperAdmin());
      }
    }

    // ==========================================================================
    // 16. NANA SWITCH CLOUD : LOGS TEMPS RÉEL & PORTEFEUILLE DE CRÉDITS
    // (/switch_logs, /switch_wallets)
    // Permet d'enregistrer les traces d'audit et de synchroniser le solde SaaS.
    // ==========================================================================
    match /switch_wallets/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isOwner(userId) || isSuperAdmin());
      match /{allChildren=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isOwner(userId) || isSuperAdmin());
      }
    }

    match /switch_logs/{logId} {
      allow create: if isSignedIn() || isSuperAdmin();
      allow read, update, delete: if isSignedIn() && (
        ('userId' in resource.data && (resource.data.userId == request.auth.uid || isOwner(resource.data.userId))) ||
        ('tenantId' in resource.data && (resource.data.tenantId == request.auth.uid || isOwner(resource.data.tenantId))) ||
        isSuperAdmin()
      );
      match /{allChildren=**} {
        allow read, write: if isSignedIn() && (
          ('userId' in resource.data && (resource.data.userId == request.auth.uid || isOwner(resource.data.userId))) ||
          ('tenantId' in resource.data && (resource.data.tenantId == request.auth.uid || isOwner(resource.data.tenantId))) ||
          isSuperAdmin()
        );
      }
    }

    // ==========================================================================
    // 17. NANA SWITCH CLOUD : COMPTES D'ORGANISATION ISOLÉS (/switch_accounts/{userId})
    // Permet aux organisations et entreprises d'accéder à leur compte Cloud isolé.
    // ==========================================================================
    match /switch_accounts/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isOwner(userId) || isSuperAdmin());
      match /{allChildren=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isOwner(userId) || isSuperAdmin());
      }
    }

    // ==========================================================================
    // 18. WAMEET SUPRA-APP : COLLECTIONS ISOLÉES (/wameet_*)
    // Profils publics, flux social, Reels, messagerie chiffrée et boutique Wameet.
    // ==========================================================================
    match /wameet_profiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /wameet_posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.authorId == request.auth.uid || !('authorId' in resource.data));
    }

    // Flux vidéos courts globaux & Wameet Reels (/reels & /wameet_reels)
    match /reels/{reelId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin() || (
        request.auth != null && (
          resource == null || 
          resource.data.authorId == request.auth.uid || 
          !('authorId' in resource.data)
        )
      );
      // Permet la mise à jour par l'auteur/admin, ou mise à jour publique ciblée sur les compteurs d'interaction
      allow update: if isSuperAdmin() || (
        request.auth != null && (
          resource.data.authorId == request.auth.uid || 
          !('authorId' in resource.data)
        )
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'resonanceCount', 'likesCount', 'sharesCount', 'shareCount', 'bookmarksCount', 'viewsCount', 'commentsCount', 'commentCount', 'updatedAt'
        ])
      );

      match /comments/{commentId} {
        allow read, create: if true;
        allow update, delete: if request.auth != null;
      }

      match /{allChildren=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    match /wameet_reels/{reelId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin() || (
        request.auth != null && (
          resource == null || 
          resource.data.authorId == request.auth.uid || 
          !('authorId' in resource.data)
        )
      );
      // Permet la mise à jour par l'auteur/admin, ou mise à jour publique ciblée sur les compteurs d'interaction
      allow update: if isSuperAdmin() || (
        request.auth != null && (
          resource.data.authorId == request.auth.uid || 
          !('authorId' in resource.data)
        )
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'resonanceCount', 'likesCount', 'sharesCount', 'shareCount', 'bookmarksCount', 'viewsCount', 'commentsCount', 'commentCount', 'updatedAt'
        ])
      );

      match /comments/{commentId} {
        allow read, create: if true;
        allow update, delete: if request.auth != null;
      }

      match /{allChildren=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Résonances, ondes de synergie et interactions Reels
    match /resonances/{resonanceId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;

      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    match /user_resonances/{pairId} {
      allow read: if true;
      allow create, update: if true;

      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    match /wameet_chats/{chatId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && (resource.data.ownerId == request.auth.uid);

      match /messages/{messageId} {
        allow read, create: if request.auth != null;
        allow update, delete: if request.auth != null && resource.data.senderId == request.auth.uid;
      }
    }

    match /wameet_messages/{messageId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.senderId == request.auth.uid || !('senderId' in resource.data));
    }

    match /wameet_shop/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.sellerId == request.auth.uid || !('sellerId' in resource.data));
    }

    // ==========================================================================
    // 19. WAMEET SIGNALISATION WEBRTC PEER-TO-PEER ÉPHÉMÈRE (/calls/{callId})
    // Offres SDP, réponses et candidats ICE strictement réservés aux membres connectés
    // ==========================================================================
    match /calls/{callId} {
      allow read, create, update, delete: if request.auth != null;

      match /callerCandidates/{candidateId} {
        allow read, create, update, delete: if request.auth != null;
      }

      match /calleeCandidates/{candidateId} {
        allow read, create, update, delete: if request.auth != null;
      }
    }

    // ==========================================================================
    // 20. ESPACES BOUTIQUES & FORMATEURS NANASORE : /nanasore_shops/{shopId}
    // Passerelle Bridge Wameet -> Nanasore pour initialiser l'espace boutique/formateur
    // ==========================================================================
    match /nanasore_shops/{shopId} {
      // 1. Lecture (get, list) : autorisée publiquement car ce sont des vitrines accessibles aux clients
      allow read: if true;

      // 2. Création et Mise à jour : autorisée si l'utilisateur est authentifié et propriétaire, ou si isSuperAdmin()
      allow create, update: if (isSignedIn() && (shopId == request.auth.uid || request.resource.data.ownerId == request.auth.uid || isOwner(shopId))) || isSuperAdmin();

      // 3. Suppression : autorisée si le propriétaire ou isSuperAdmin()
      allow delete: if (isSignedIn() && (shopId == request.auth.uid || resource.data.ownerId == request.auth.uid || isOwner(shopId))) || isSuperAdmin();

      // Sous-collections éventuelles de la boutique
      match /{allChildren=**} {
        allow read: if true;
        allow write: if (isSignedIn() && (shopId == request.auth.uid || isOwner(shopId))) || isSuperAdmin();
      }
    }

    // ==========================================================================
    // 21. ÉVÉNEMENTS LIVE & TIROIR LIVE SYNC : /live_events/{liveId}
    // Moteur E-Commerce & Le Tiroir Nanasore Live Sync
    // ==========================================================================
    match /live_events/{liveId} {
      // 1. Lecture (get, list) : autorisée publiquement pour écoute temps réel (activeProductId, etc.)
      allow read: if true;

      // 2. Écriture (create, update, delete) : autorisée si l'utilisateur est authentifié ou Super Admin
      allow create, update, delete: if isSignedIn() || isSuperAdmin();

      // 3. Sous-collections (ex: /live_events/{liveId}/{allChildren=**})
      match /{allChildren=**} {
        allow read: if true;
        allow write: if isSignedIn() || isSuperAdmin();
      }
    }

    // ==========================================================================
    // 22. PRODUITS DU CATALOGUE NANASORE : /nanasore_products/{productId}
    // ==========================================================================
    match /nanasore_products/{productId} {
      allow read, create: if true;
      allow update, delete: if (isSignedIn() || isSuperAdmin()) && isNotDemo();

      match /{allChildren=**} {
        allow read, create: if true;
        allow update, delete: if (isSignedIn() || isSuperAdmin()) && isNotDemo();
      }
    }

    // ==========================================================================
    // 23. COFFRES ET CONTENUS DÉVERROUILLÉS : /unlocked_vaults/{lockId}
    // ==========================================================================
    match /unlocked_vaults/{lockId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;

      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // ==========================================================================
    // 24. CHATS ET MESSAGERIE : /chats/{chatId}
    // ==========================================================================
    match /chats/{chatId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;

      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // ==========================================================================
    // 25. PUBLICATIONS FLUX SOCIAL MULTI-FORMAT : /social_feed_posts/{postId}
    // Permet la publication et les interactions multi-formats (PRODUCT_POST, AD_POST, IDEA_POST)
    // ==========================================================================
    match /social_feed_posts/{postId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;

      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // ==========================================================================
    // 26. TUTORIELS, VIDÉOS D'ONBOARDING & EXPLICATIONS SARAH :
    // (/tutorials, /tutorials_config, /onboarding_videos, /sarah_tutorials, /academy_tutorials)
    // Lecture publique autorisée sans authentification pour l'onboarding et le catalogue de tutoriels ;
    // écriture strictement réservée au Super Admin.
    // ==========================================================================
    match /tutorials/{tutorialId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /{allChildren=**} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    match /tutorials_config/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /{allChildren=**} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    match /onboarding_videos/{videoId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /{allChildren=**} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    match /sarah_tutorials/{tutorialId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /{allChildren=**} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    match /academy_tutorials/{tutorialId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /{allChildren=**} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    // ==========================================================================
    // 27. CARTES ET CATALOGUE PUBLIC NANAMARKET : /nanamarket_cards/{cardId}
    // Cartes publiques NanaMarket et sous-collections associées
    // ==========================================================================
    match /nanamarket_cards/{cardId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated() || isSuperAdmin();

      match /{allChildren=**} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isAuthenticated() || isSuperAdmin();
      }
    }

    // ==========================================================================
    // 28. CONFIGURATION SYSTÈME & CENTRAL HUB : /system_config/{document}
    // Permet la lecture publique de la configuration du Hub Central et restreint
    // l'écriture exclusivement aux Super-Administrateurs
    // ==========================================================================
    match /system_config/{document} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /{allChildren=**} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }
  }
}


