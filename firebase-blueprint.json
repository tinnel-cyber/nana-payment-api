{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NanaPOS_MultiTenant_Blueprint",
  "description": "Schéma et modèle de données multi-tenant Firestore pour Nana POS avec isolation stricte par storeId",
  "entities": {
    "User": {
      "path": "users/{userId}",
      "fields": {
        "id": { "type": "string" },
        "storeId": { "type": "string", "description": "Identifiant unique et immuable de la boutique" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "storeName": { "type": "string" },
        "role": { "type": "string", "enum": ["GERANT", "CAISSIER", "ADMIN"] },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "currency": { "type": "string" }
      },
      "required": ["id", "storeId", "email", "storeName", "role"]
    },
    "Sale": {
      "path": "sales/{saleId}",
      "fields": {
        "id": { "type": "string" },
        "storeId": { "type": "string", "description": "Clé d'isolation tenant de la boutique" },
        "date": { "type": "string" },
        "timestamp": { "type": "number" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["CASH", "CREDIT"] },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "sellerSignatureCode": { "type": "string" },
        "integrityHash": { "type": "string" }
      },
      "required": ["id", "storeId", "total", "items", "paymentMethod"]
    },
    "Inventory": {
      "path": "inventory/{productId}",
      "fields": {
        "id": { "type": "string" },
        "storeId": { "type": "string", "description": "Clé d'isolation tenant" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "costPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "stock": { "type": "number" },
        "unit": { "type": "string" }
      },
      "required": ["id", "storeId", "name", "sellingPrice", "stock"]
    },
    "Customer": {
      "path": "customers/{customerId}",
      "fields": {
        "id": { "type": "string" },
        "storeId": { "type": "string", "description": "Clé d'isolation tenant" },
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "phone": { "type": "string" },
        "totalDebt": { "type": "number" },
        "entries": { "type": "array" }
      },
      "required": ["id", "storeId", "name", "totalDebt"]
    },
    "Loss": {
      "path": "losses/{lossId}",
      "fields": {
        "id": { "type": "string" },
        "storeId": { "type": "string", "description": "Clé d'isolation tenant" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "costPrice": { "type": "number" },
        "lossAmount": { "type": "number" },
        "reason": { "type": "string", "enum": ["CASSE", "PERIME", "VOL", "AUTRE"] }
      },
      "required": ["id", "storeId", "productId", "quantity", "lossAmount", "reason"]
    },
    "StockMovement": {
      "path": "stockMovements/{movementId}",
      "fields": {
        "id": { "type": "string" },
        "storeId": { "type": "string", "description": "Clé d'isolation tenant" },
        "productId": { "type": "string" },
        "type": { "type": "string", "enum": ["ARRIVAGE", "RAPPROCHEMENT", "VENTE", "AJOUT_PRODUIT", "PERTE"] },
        "quantityDelta": { "type": "number" }
      },
      "required": ["id", "storeId", "productId", "type", "quantityDelta"]
    },
    "Store": {
      "path": "stores/{storeId}",
      "fields": {
        "id": { "type": "string" },
        "storeName": { "type": "string" },
        "slug": { "type": "string" },
        "whatsappPhone": { "type": "string" },
        "welcomeText": { "type": "string" },
        "customDomain": { "type": "string" },
        "primaryColor": { "type": "string" },
        "fbPixelId": { "type": "string" },
        "tiktokPixelId": { "type": "string" },
        "bannerImage": { "type": "string" }
      }
    }
  }
}
